+  localparam ILEN = 32;
+
+  typedef struct packed {
+    logic [NRET-1:0]                 valid;
+    logic [NRET*63:0]                order;
+    logic [NRET*ILEN-1:0]            insn;
+    logic [NRET-1:0]                 trap;
