+          annotationsYaml.convertTo[Array[Annotation]]
+        } else {
+          Array[Annotation]()
+        }
+      }
+    }
+    AnnotationMap(annotationArray)
+  }
 
   // Top Generation
   protected def firstPhase(top: Boolean, harness: Boolean): Unit = {
