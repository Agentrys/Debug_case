+    }, orient='index', columns=['RealTime'])
+
+# This is taken from agfi-0fa2162c2c1a475d4
+# (firesim-rocket-quadcore-no-nic-l2-llc4mb-ddr3 circa oct 13 2020)
+# specSpeedTest = pd.DataFrame.from_dict({
+#     "600.perlbench_s" : 59.87,
+#     "602.gcc_s" : 0.04,
+#     "605.mcf_s" : 32.12,
